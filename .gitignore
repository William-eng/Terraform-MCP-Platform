
# Terraform working directory
**/.terraform/*

# Terraform state files
*.tfstate
*.tfstate.*
*.tfstate.backup

# Terraform plan files
*.tfplan
tfplan
tfplan.*

# Local variable files (may contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Environment and credential files
.env
.env.*
!.env.example
*.pem
*.key
*.pfx

# Local development
.vscode/settings.json
.vscode/launch.json
